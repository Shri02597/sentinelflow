# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Local dev fallback (SQLite):
DATABASE_URL=sqlite:///./sentinelflow.db
# Production (Postgres) example:
# DATABASE_URL=postgresql+psycopg2://sentinelflow:password@localhost:5432/sentinelflow

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-64-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS / Frontend ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Detection thresholds (all optional overrides — defaults live in config.py) ---
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_SECONDS=300
ABNORMAL_RATE_NORMAL_MAX=30
ABNORMAL_RATE_SUSPICIOUS_MIN=100
ABNORMAL_RATE_WINDOW_SECONDS=60
SUSPICIOUS_ENDPOINT_404_THRESHOLD=10
SUSPICIOUS_ENDPOINT_WINDOW_SECONDS=300
BEHAVIORAL_BASELINE_WINDOW_MINUTES=30
BEHAVIORAL_DEVIATION_MULTIPLIER=3.0
